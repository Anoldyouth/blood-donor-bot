# Скопируйте в .env и заполните. Файл .env в git не попадает.
DONOR_LOGIN=you@example.com
DONOR_PASSWORD=your_password

# Ключ rucaptcha.com — для сайтов, где вместо галочки капча требует задание (Шаболовка)
CAPTCHA_API_KEY=

# Необязательно: уведомление в Telegram о записи
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
