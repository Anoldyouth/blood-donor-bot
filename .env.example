# Скопируйте в .env и заполните. Файл .env в git не попадает.
DONOR_LOGIN=you@example.com
DONOR_PASSWORD=your_password

# Необязательно: уведомления в Telegram о результате
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Ключ сервиса распознавания капчи (rucaptcha.com / 2captcha.com) — нужен,
# если Яндекс SmartCaptcha показывает задание, а не только чекбокс
CAPTCHA_API_KEY=
